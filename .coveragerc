; Coverage configuration file
; DO NOT CHANGE THIS FILE!

[run]
branch = True
omit =
    *__init__.py
    manage.py
    */migrations/*.py
    *settings.py
    *test*
    admin.py
    apps.py
    seed.py
    unseed.py
    /nix/*

[report]
exclude_lines =
    pragma: no cover
    # no-coverage   
    for part in msg\.walk\(\):
    for eid in email_ids:
